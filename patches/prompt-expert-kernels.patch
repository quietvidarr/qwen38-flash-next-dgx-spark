+"""Opt-in integration policy for grearjake-star's original TensorFold PR #212.
+
+Startup-only switch. Counters observe successful Python prompt dispatches,
+not CUDA completion or graph replays; baseline/decode have no counter writes.
+"""
+from __future__ import annotations
+
+import os
+
+_raw = os.environ.get("QWEN_PREFILL_KERNEL", "0")
+if _raw not in ("0", "1"):
+    raise ValueError("QWEN_PREFILL_KERNEL must be exactly 0 or 1")
+ENABLED = _raw == "1"
+PROMPT_ROWS = 64
+MOE_WINDOW = 2048 if ENABLED else 1024
+_calls = _rows = _pairs = 0
+
+
+def eligible(rows: int, *, prompt: bool, group: bool = True) -> bool:
+    return ENABLED and prompt and group and rows > PROMPT_ROWS
+
+
+def record(rows: int, slots: int) -> None:
+    global _calls, _rows, _pairs
+    _calls += 1
+    _rows += rows
+    _pairs += rows * slots
+
+
+def engagement() -> dict:
+    return {"enabled": ENABLED, "prompt_dispatch_calls": _calls,
+            "prompt_rows": _rows, "prompt_pairs": _pairs,
+            "counter_scope": "successful_python_dispatch_not_cuda_completion_or_graph_replay"}
+
+
+def plan_nbytes(rows: int, slots: int, experts: int) -> int:
+    """Full allocated Plan carrier plus clamped picks, including 16-pair item capacity."""
+    pairs = rows * slots
+    items = min(pairs, experts) + pairs // 16
+    wide = pairs > 1024
+    return 4 * (2 * pairs + 3 * items + 2 + (pairs if wide else 1)
+                + ((-(-pairs // 1024)) * experts if wide else 1))
+
+
+def admission_extra(rows: int, slots: int, experts: int) -> int:
+    """Add full prompt plan and correct the base estimator's member-table bound.
+
+    ``experts`` includes the shared expert, but not the skipped-pick sentinel.
+    Base exl3_indexed_scratch already includes (pairs + 1024) int32 entries.
+    """
+    pairs = rows * slots
+    grouped = 4 * (min(pairs, experts) * (rows + 1) + 1)
+    return plan_nbytes(rows, slots, experts + 1) + max(0, grouped - 4 * (pairs + 1024))
